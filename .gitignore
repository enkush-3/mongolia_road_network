# ==========================================
# 3. BACKEND (Spring Boot / Maven)
# ==========================================
# Build хийхэд гардаг үр дүнгийн хавтас
backend/target/
backend/build/

# Maven-ий өөрийн ажиллуулах файлууд (хэрэв локал дээр хэрэггүй бол)
