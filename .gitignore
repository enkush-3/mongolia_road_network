# ==========================================
# 1. СҮҮЛИЙН ҮЕИЙН СИСТЕМҮҮДИЙН ФАЙЛУУД (OS)
# ==========================================
.DS_Store
Thumbs.db
*.log
*.tmp

# ==========================================
# 2. ХӨГЖҮҮЛЭЛТИЙН ОРЧИН (IDE / Editors)
# ==========================================
.idea/
.vscode/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln

# ==========================================
# 3. BACKEND (Spring Boot / Maven)
# ==========================================
# Build хийхэд гардаг үр дүнгийн хавтас
backend/target/
backend/build/

# Maven-ий өөрийн ажиллуулах файлууд (хэрэв локал дээр хэрэггүй бол)
backend/.mvn/
backend/mvnw
backend/mvnw.cmd

# Багцалсан файлууд
backend/*.jar
backend/*.war

# ==========================================
# 4. FRONTEND (Vite / React / Node.js)
# ==========================================
# Суулгасан сангууд (Хамгийн хүнд хавтас)
frontend/mongolia_road_network/node_modules/

# Production build хийхэд үүсдэг хавтас
frontend/mongolia_road_network/dist/
frontend/mongolia_road_network/build/

# Vite болон бусад кэшүүд
frontend/mongolia_road_network/.vite/
frontend/mongolia_road_network/.nuxt/
frontend/mongolia_road_network/.next/

# Локал орчны нууц түлхүүрүүд (Environment variables)
frontend/mongolia_road_network/.env
frontend/mongolia_road_network/.env.local
frontend/mongolia_road_network/.env.development.local
frontend/mongolia_road_network/.env.test.local
frontend/mongolia_road_network/.env.production.local

# TypeScript build кэш
frontend/mongolia_road_network/*.tsbuildinfo


# ==========================================
# 5. DOCKER (контейнержуулалтын файлууд)
# ==========================================
# Docker Compose-ийн override файлууд (локал өөрчлөлт)
docker-compose.override.yml
docker-compose.local.yml

# Docker build-ийн түр хавтас, кэш
.docker-build/
docker/*.tmp

# ==========================================
# 6. ENVIRONMENT FILES (Backend)
# ==========================================
backend/.env
backend/application-local.properties
backend/application-dev.properties
backend/application-prod.properties

# ==========================================
# 7. DEPENDENCY CACHE (Node.js / pnpm / npm)
# ==========================================
frontend/mongolia_road_network/.pnpm-store/
frontend/mongolia_road_network/node_modules/.cache/
frontend/mongolia_road_network/package-lock.json
frontend/mongolia_road_network/yarn.lock

# ==========================================
# 8. LOGS болон ТҮР ФАЙЛУУД (Backend)
# ==========================================
backend/logs/
backend/*.log
backend/temp/